{
  "name": "task-handoff-monorepo",
  "version": "0.0.1",
  "description": "Run and supervise AI workspaces through a control plane.",
  "author": {
    "name": "TaskHandoff",
    "email": "hdreamcom@gmail.com"
  },
  "private": true,
  "type": "commonjs",
  "main": "apps/desktop-shell/src/main.cjs",
  "packageManager": "pnpm@9.15.3",
  "bin": {
    "task-handoff": "bin/task-handoff.js"
  },
  "files": [
    "bin",
    "dist",
    "apps",
    "packages",
    "scripts/install-server-services.sh",
    "scripts/install-server.sh",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pnpm run build:legacy",
    "build:all": "pnpm run build:legacy && pnpm run web:build",
    "build:controlled-instance": "TASK_HANDOFF_ROLLUP_TARGET=controlled-instance rollup -c",
    "build:legacy": "rollup -c",
    "cli": "node bin/task-handoff.js",
    "typecheck": "pnpm run typecheck:legacy",
    "typecheck:controlled-instance": "tsc -p tsconfig.controlled-instance.json --noEmit",
    "typecheck:legacy": "tsc -p tsconfig.json --noEmit",
    "control-plane-ui:typecheck": "pnpm --filter @task-handoff/control-plane-ui typecheck",
    "control-plane-ui:build": "pnpm --filter @task-handoff/control-plane-ui build",
    "control-plane-ui:dev": "pnpm --filter @task-handoff/control-plane-ui dev",
    "control-plane-ui:preview": "pnpm --filter @task-handoff/control-plane-ui preview",
    "controlled-instance-ui:typecheck": "pnpm --filter @task-handoff/controlled-instance-ui typecheck",
    "controlled-instance-ui:build": "pnpm --filter @task-handoff/controlled-instance-ui build",
    "controlled-instance-ui:dev": "pnpm --filter @task-handoff/controlled-instance-ui dev",
    "controlled-instance-ui:preview": "pnpm --filter @task-handoff/controlled-instance-ui preview",
    "runtime:build": "node scripts/build-runtime-packages.mjs",
    "runtime:pack": "node scripts/build-runtime-packages.mjs --pack",
    "runtime:pack:controlled-instance": "node scripts/build-runtime-packages.mjs --target controlled-instance --pack",
    "web:typecheck": "pnpm run control-plane-ui:typecheck && pnpm run controlled-instance-ui:typecheck",
    "web:build": "pnpm run control-plane-ui:build && pnpm run controlled-instance-ui:build",
    "desktop:start": "pnpm --filter @task-handoff/desktop-shell start",
    "desktop:check": "pnpm --filter @task-handoff/desktop-shell check",
    "desktop:prepare": "pnpm run build:legacy && pnpm run control-plane-ui:build && pnpm run desktop:check",
    "desktop:dist": "pnpm run desktop:prepare && electron-builder --publish never",
    "check": "node bin/check-package-boundaries.js && pnpm run typecheck:legacy && pnpm run build:legacy && node bin/check-dist.js",
    "check:controlled-instance": "node bin/check-package-boundaries.js && pnpm run typecheck:controlled-instance && pnpm run controlled-instance-ui:typecheck && pnpm run build:controlled-instance && node bin/check-dist.js",
    "docker:build:image": "sh scripts/docker-build-image.sh",
    "docker:build:image:all-optional": "sh scripts/docker-build-image-all-optional.sh",
    "docker:up:all": "sh scripts/docker-up-all-optional.sh",
    "pack:dry": "pnpm run build:legacy && npm_config_cache=/private/tmp/task-handoff-npm-cache npm pack --dry-run",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "license": "Apache-2.0",
  "build": {
    "appId": "com.taskhandoff.desktop",
    "productName": "TaskHandoff",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "afterPack": "apps/desktop-shell/scripts/after-pack.cjs",
    "asar": true,
    "asarUnpack": [
      "bin/**/*",
      "dist/**/*",
      "packages/control-plane-ui/dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "files": [
      "apps/desktop-shell/src/**/*",
      "bin/task-handoff.js",
      "dist/**/*",
      "packages/control-plane-ui/dist/**/*",
      "!node_modules/node-pty/build{,/**/*}",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@iarna/toml": "^2.2.5",
    "@lucide/vue": "^1.21.0",
    "@tanstack/vue-query": "^5.91.2",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.6.2",
    "dingtalk-stream": "2.1.5",
    "fastify": "^5.6.2",
    "httpxy": "^0.5.3",
    "ky": "^1.14.1",
    "marked": "^15.0.12",
    "node-pty": "^1.1.0",
    "pinia": "^3.0.4",
    "picomatch": "^4.0.5",
    "reka-ui": "^2.6.1",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.5.20",
    "telegramify-markdown": "^1.3.3",
    "tslib": "^2.8.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "write-file-atomic": "^8.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^25.9.1",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "autoprefixer": "^10.4.23",
    "electron": "catalog:",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "rollup": "^4.60.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.8"
  }
}
