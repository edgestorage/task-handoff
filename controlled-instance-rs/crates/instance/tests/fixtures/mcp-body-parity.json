  {
    "name": "declared JSON length mismatch",
    "method": "POST",
    "type": "application/json",
    "auth": true,
    "unit": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}",
    "repeat": 1,
    "declaredLength": 100,
    "expected": {
      "status": 400,
      "body": {
        "statusCode": 400,
        "code": "FST_ERR_CTP_INVALID_CONTENT_LENGTH",
        "error": "Bad Request",
        "message": "Request body size did not match Content-Length"
      }
    }
  },
  {
    "name": "declared JSON oversize",
    "method": "POST",
    "type": "application/json",
    "auth": true,
    "unit": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}",
    "repeat": 1,
    "declaredLength": 300000,
    "expected": {
      "status": 413,
      "body": {
        "statusCode": 413,
        "code": "FST_ERR_CTP_BODY_TOO_LARGE",
        "error": "Payload Too Large",
        "message": "Request body is too large"
      }
    }
  },
  {
    "name": "declared JSON oversize before authorization",
    "method": "POST",
    "type": "application/json",
    "auth": false,
    "unit": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}",
    "repeat": 1,
    "declaredLength": 300000,
    "expected": {
      "status": 413,
      "body": {
        "statusCode": 413,
        "code": "FST_ERR_CTP_BODY_TOO_LARGE",
        "error": "Payload Too Large",
        "message": "Request body is too large"
      }
    }
  },
