[
  {
    "name": "ping",
    "method": "POST",
    "type": "application/json",
    "auth": true,
    "unit": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}",
    "repeat": 1,
    "expected": {
      "status": 200,
      "events": [
        {
          "result": {},
          "jsonrpc": "2.0",
          "id": 1
        }
      ]
    }
  },
  {
    "name": "BOM ping",
    "method": "POST",
    "type": "application/json",
    "auth": true,
    "unit": "﻿{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}",
    "repeat": 1,
    "expected": {
      "status": 200,
      "events": [
        {
          "result": {},
          "jsonrpc": "2.0",
          "id": 1
        }
      ]
    }
  },
  {
    "name": "BOM ping without authorization",
    "method": "POST",
    "type": "application/json",
    "auth": false,
    "unit": "﻿{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}",
    "repeat": 1,
    "expected": {
      "status": 403,
      "body": {
        "error": {
          "code": "AGENT_TOOL_FORBIDDEN",
          "message": "Agent tool token is required."
        }
      }
    }
  },
  {
    "name": "BOM only",
    "method": "POST",
    "type": "application/json",
    "auth": true,
    "unit": "﻿",
    "repeat": 1,
    "expected": {
      "status": 400,
      "body": {
        "statusCode": 400,
        "code": "FST_ERR_CTP_INVALID_JSON_BODY",
        "error": "Bad Request",
        "message": "Body is not valid JSON but content-type is set to 'application/json'"
      }
    }
  },
  {
    "name": "double BOM",
    "method": "POST",
    "type": "application/json",
    "auth": true,
    "unit": "﻿﻿{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}",
    "repeat": 1,
    "expected": {
      "status": 400,
      "body": {
        "statusCode": 400,
        "code": "FST_ERR_CTP_INVALID_JSON_BODY",
        "error": "Bad Request",
        "message": "Body is not valid JSON but content-type is set to 'application/json'"
      }
    }
  },
  {
    "name": "empty JSON",
    "method": "POST",
    "type": "application/json",
    "auth": true,
    "unit": "",
    "repeat": 1,
    "expected": {
      "status": 400,
      "body": {
        "statusCode": 400,
        "code": "FST_ERR_CTP_EMPTY_JSON_BODY",
        "error": "Bad Request",
        "message": "Body cannot be empty when content-type is set to 'application/json'"
      }
    }
  },
