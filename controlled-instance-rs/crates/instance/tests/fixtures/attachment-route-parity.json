        }
      }
    }
  },
  {
    "name": "missing stream before body limit",
    "method": "PUT",
    "url": "/api/ai-session-attachments/draft-streams/cia_ffffffffffffffffffffffff?offset=0",
    "unit": "x",
    "type": "application/octet-stream",
    "repeat": 600000,
    "expected": {
      "status": 404,
      "body": {
        "error": {
          "code": "AI_SESSION_ATTACHMENT_UPLOAD_NOT_FOUND",
          "message": "AI session attachment upload not found."
        }
      }
    }
  },
  {
    "name": "bad id before body limit",
    "method": "PUT",
    "url": "/api/ai-session-attachments/draft-streams/bad-id?offset=0",
    "unit": "x",
    "type": "application/octet-stream",
    "repeat": 600000,
    "expected": {
      "status": 400,
      "body": {
        "error": {
          "code": "AI_SESSION_CONTROL_INVALID",
          "message": "body: Invalid string: must match pattern /^cia_[a-f0-9]{24}$/"
        }
      }
    }
  },
  {
    "name": "large binary stream append",
    "method": "PUT",
    "url": "/api/ai-session-attachments/draft-streams/cia_0123456789abcdef01234567?offset=0",
    "unit": "x",
    "type": "application/octet-stream",
    "repeat": 600000,
    "expected": {
      "status": 200,
      "body": {
        "data": {
          "attachmentId": "cia_0123456789abcdef01234567",
          "offset": 600000
        }
      }
    }
  },
  {
    "name": "stale offset after large append",
    "method": "PUT",
    "url": "/api/ai-session-attachments/draft-streams/cia_0123456789abcdef01234567?offset=0",
    "unit": "x",
    "type": "application/octet-stream",
    "repeat": 600000,
    "expected": {
      "status": 409,
      "body": {
        "error": {
          "code": "AI_SESSION_ATTACHMENT_OFFSET_MISMATCH",
          "message": "AI session attachment upload offset does not match."
        }
      }
    }
  },
  {
    "name": "cancel stream",
    "method": "DELETE",
    "url": "/api/ai-session-attachments/draft-streams/cia_0123456789abcdef01234567",
    "unit": "",
    "expected": {
      "status": 200,
      "body": {
        "data": {
          "removed": true
        }
      }
    }
  }
