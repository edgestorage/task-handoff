  {
    "name": "binary missing session before size limit",
    "method": "POST",
    "url": "/api/ai-session-attachments/drafts?scopeType=session&scopeId=upload-test&kind=file&name=notes.txt&mime=text%2Fplain&size=5",
    "unit": "x",
    "generatedId": true,
    "repeat": 23068672,
    "expected": {
      "status": 404,
      "body": {
        "error": {
          "code": "AI_SESSION_NOT_FOUND",
          "message": "AI session not found."
        }
      }
    }
