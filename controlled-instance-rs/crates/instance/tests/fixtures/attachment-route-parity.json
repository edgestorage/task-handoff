  {
    "name": "begin large stream",
    "method": "POST",
    "url": "/api/ai-session-attachments/draft-streams",
    "type": "application/json",
    "unit": "{\"attachmentId\":\"cia_0123456789abcdef01234567\",\"scopeType\":\"create-request\",\"scopeId\":\"upload-test\",\"kind\":\"image\",\"name\":\"stream.txt\",\"mime\":\"image/png\",\"size\":800000}",
    "expected": {
      "status": 201,
      "body": {
        "data": {
          "attachmentId": "cia_0123456789abcdef01234567",
          "offset": 0
        }
      }
    }
  },
  {
    "name": "append duplicate offset",
    "method": "PUT",
    "url": "/api/ai-session-attachments/draft-streams/cia_0123456789abcdef01234567?offset=0&offset=0",
    "unit": "hello",
    "expected": {
      "status": 400,
      "body": {
        "error": {
          "code": "AI_SESSION_CONTROL_INVALID",
          "message": "offset: Invalid input: expected number, received NaN"
        }
      }
    }
  },
  {
    "name": "append unknown query order",
    "method": "PUT",
    "url": "/api/ai-session-attachments/draft-streams/cia_0123456789abcdef01234567?offset=0&z=1&a=2",
    "unit": "hello",
    "expected": {
      "status": 400,
      "body": {
        "error": {
          "code": "AI_SESSION_CONTROL_INVALID",
