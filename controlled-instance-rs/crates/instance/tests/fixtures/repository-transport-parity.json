[
  {
    "method": "POST",
    "suffix": "files",
    "name": "empty json",
    "type": "application/json",
    "unit": "",
    "repeat": 1,
    "expected": {
      "status": 400,
      "body": {
        "statusCode": 400,
        "code": "FST_ERR_CTP_EMPTY_JSON_BODY",
        "error": "Bad Request",
        "message": "Body cannot be empty when content-type is set to 'application/json'"
      }
    }
  },
  {
    "method": "POST",
    "suffix": "files",
    "name": "invalid json",
    "type": "application/json",
    "unit": "{",
    "repeat": 1,
