  {
    "name": "create body {\"path\":4,\"content\":null,\"expectedAbsent\":false,\"expectedSnapshotId\":[]}",
    "method": "POST",
    "suffix": "files",
    "body": {
      "path": 4,
      "content": null,
      "expectedAbsent": false,
      "expectedSnapshotId": []
    },
    "expected": {
      "status": 400,
      "error": {
        "code": "REPOSITORY_REQUEST_INVALID",
        "message": "Invalid input: expected string, received number; Invalid input: expected string, received null; Invalid input: expected true; Invalid input: expected string, received array; Too small: expected array to have >=1 items",
        "retryable": false
      }
    }
  },
  {
    "name": "create body {\"1\":4,\"2\":3,\"path\":\"normal.txt\",\"content\":\"content\",\"expectedAbsent\":true,\"expectedSnapshotId\":\"snapshot:test\",\"z\":1,\"a\":2}",
    "method": "POST",
    "suffix": "files",
    "body": {
      "1": 4,
      "2": 3,
      "path": "normal.txt",
      "content": "content",
      "expectedAbsent": true,
      "expectedSnapshotId": "snapshot:test",
      "z": 1,
      "a": 2
    },
    "expected": {
      "status": 400,
      "error": {
        "code": "REPOSITORY_REQUEST_INVALID",
        "message": "Unrecognized keys: \"1\", \"2\", \"z\", \"a\"",
        "retryable": false
      }
    }
  },
  {
    "name": "stage nested strict fields",
    "method": "POST",
    "suffix": "index/stage",
    "body": {
      "expectedSnapshotId": "snapshot:test",
      "paths": [
        {
          "path": "a",
          "expectedVersion": "version:1234567890",
          "z": 1,
          "a": 2
        }
      ]
    },
    "expected": {
      "status": 400,
      "error": {
        "code": "REPOSITORY_REQUEST_INVALID",
        "message": "Unrecognized keys: \"z\", \"a\"",
        "retryable": false
      }
    }
  },
  {
    "name": "rename non drive prefix",
    "method": "POST",
    "suffix": "files/rename",
    "body": {
      "path": "normal.txt",
      "destination": "1:/file.txt",
      "expectedVersion": "version:1234567890",
      "expectedDestinationAbsent": true,
      "expectedSnapshotId": "snapshot:test"
    },
    "expected": {
      "status": 404,
      "error": {
        "code": "REPOSITORY_SESSION_NOT_FOUND",
        "message": "Workspace is unavailable for this session.",
        "retryable": false
      }
    }
  },
