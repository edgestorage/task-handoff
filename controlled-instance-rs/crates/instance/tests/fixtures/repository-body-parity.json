[
  {
    "name": "create path 1:/file.txt",
    "method": "POST",
    "suffix": "files",
    "body": {
      "path": "1:/file.txt",
      "content": "content",
      "expectedAbsent": true,
      "expectedSnapshotId": "snapshot:test"
    },
    "expected": {
      "status": 404,
      "error": {
        "code": "REPOSITORY_SESSION_NOT_FOUND",
        "message": "Workspace is unavailable for this session.",
        "retryable": false
      }
    }
  },
