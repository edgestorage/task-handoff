  "messages": [
    {
      "name": "without-attachments",
      "message": "  hello  ",
      "files": [],
      "expected": "  hello  \n"
    },
    {
      "name": "file-message-trim",
      "message": "  hello  ",
      "files": [
        {
          "kind": "file",
          "path": "/attachment.txt"
        }
      ],
      "expected": "hello\n\n文件路径：/attachment.txt\n"
    },
    {
      "name": "attachment-only",
      "message": " \n ",
      "files": [
        {
          "kind": "image",
          "path": "/attachment.txt"
        }
      ],
      "expected": "图片路径：/attachment.txt\n"
    },
    {
      "name": "separate-kind-indexes",
      "message": "\n describe \n",
      "files": [
        {
          "kind": "image",
          "path": "/attachment.txt"
        },
        {
          "kind": "file",
          "path": "/attachment.txt"
        },
        {
          "kind": "image",
          "path": "/attachment.txt"
        }
      ],
      "expected": "describe\n\n图片1路径：/attachment.txt\n文件路径：/attachment.txt\n图片2路径：/attachment.txt\n"
    }
