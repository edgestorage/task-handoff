{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "rootDir": ".",
    "outDir": "dist",
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@task-handoff/ai-session-runtime": ["packages/ai-session-runtime/src/index.ts"],
      "@task-handoff/ai-session-runtime/*": ["packages/ai-session-runtime/src/*.ts"],
      "@task-handoff/app-runtime": ["packages/app-runtime/src/index.ts"],
      "@task-handoff/app-runtime/*": ["packages/app-runtime/src/*.ts"],
      "@task-handoff/cloud-contracts": ["packages/cloud-contracts/src/index.ts"],
      "@task-handoff/cloud-contracts/*": ["packages/cloud-contracts/src/*.ts"],
      "@task-handoff/core": ["packages/core/src/index.ts"],
      "@task-handoff/core/*": ["packages/core/src/*"],
      "@task-handoff/node-agent": ["packages/node-agent/src/index.ts"],
      "@task-handoff/node-agent/app": ["packages/node-agent/src/app.ts"],
      "@task-handoff/node-agent/bootstrap-assets": ["packages/node-agent/src/runtimes/bootstrap-assets.ts"],
      "@task-handoff/node-agent/executor": ["packages/node-agent/src/runtimes/docker.ts"],
      "@task-handoff/node-agent/folders": ["packages/node-agent/src/folders.ts"],
      "@task-handoff/node-agent/schemas": ["packages/node-agent/src/schemas.ts"],
      "@task-handoff/protocol": ["packages/protocol/src/index.ts"],
      "@task-handoff/protocol/*": ["packages/protocol/src/*.ts"],
      "@task-handoff/runtime-shared/*": ["packages/runtime-shared/src/*.ts"]
    },
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps/cli/src/**/*",
    "apps/thctl/src/**/*",
    "apps/controlled-instance-image/src/**/*",
    "scripts/node-update-worker.cts",
    "packages/core/src/**/*",
    "packages/cloud-contracts/src/**/*",
    "packages/protocol/src/**/*",
    "packages/app-runtime/src/**/*",
    "packages/ai-session-runtime/src/**/*",
    "packages/controlled-instance/src/**/*",
    "packages/control-plane/src/**/*",
    "packages/node-agent/src/**/*",
    "packages/runtime-shared/src/**/*"
  ],
  "exclude": ["packages/control-plane-ui/**/*", "packages/controlled-instance-ui/**/*"]
}
