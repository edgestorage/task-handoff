{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "TASK_HANDOFF_MOBILE_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "TASK_HANDOFF_MOBILE_VARIANT": "production"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "TASK_HANDOFF_MOBILE_VARIANT": "production"
      }
    },
    "android-release": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "TASK_HANDOFF_MOBILE_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
