{
  "name": "@task-handoff/mobile",
  "version": "0.0.1",
  "description": "TaskHandoff mobile Control Plane client.",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@bsky.app/react-native-uitextview": "2.6.0",
    "@expo/ui": "~57.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-menu/menu": "^2.0.0",
    "@task-handoff/control-plane-client": "workspace:*",
    "@task-handoff/cloud-contracts": "workspace:*",
    "@task-handoff/protocol": "workspace:*",
    "expo": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "^57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-libghostty": "^0.8.1",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-paste-input": "0.2.2",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-widgets": "~57.0.8",
    "lowlight": "3.3.0",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-renderer": "4.1.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.10.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "prebuild:check": "expo prebuild --clean --no-install",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "export:audit": "pnpm run export:audit:ios && pnpm run export:audit:android",
    "export:audit:ios": "expo export --platform ios --output-dir dist/audit/ios",
    "export:audit:android": "expo export --platform android --output-dir dist/audit/android",
    "check:bundle": "node scripts/check-boundaries.mjs --bundle-dir dist/audit",
    "release:check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:boundaries && pnpm run prebuild:check && pnpm run export:audit && pnpm run check:bundle",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "web": "expo start --web"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@bsky.app/react-native-uitextview$": "<rootDir>/__mocks__/react-native-uitextview.tsx"
    },
    "transform": {
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "expo/internal/babel-preset"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|react-native-svg|lucide-react-native|lowlight|highlight.js|devlop|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@task-handoff/.*))"
    ]
  },
  "private": true
}
