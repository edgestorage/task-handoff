{
  "expo": {
    "name": "TaskHandoff Dev",
    "slug": "task-handoff-mobile",
    "version": "0.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "taskhandoff-dev",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f2f7",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/icon.png"
          },
          "image": "./assets/icon.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Allow TaskHandoff to select an image to attach to an AI session."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskhandoff.mobile.dev",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "zh-Hans"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.taskhandoff.mobile.dev",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "variant": "development"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
