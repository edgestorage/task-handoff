{
  "expo": {
    "name": "TaskHandoff Dev",
    "slug": "task-handoff-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "taskhandoff-dev",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Allow TaskHandoff to select an image to attach to an AI session."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskhandoff.mobile.dev",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.taskhandoff.mobile.dev",
      "adaptiveIcon": {
        "backgroundColor": "#eaf6ff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "variant": "development"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
