<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="TaskHandoff Remote Desktop"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="TaskHandoff"
    UpgradeCode="{A3E4E8F6-C1AB-43EC-8454-FE8C178DFD69}">
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perUser"
      InstallPrivileges="limited"
      Platform="x64"
      Description="TaskHandoff native remote desktop component" />
    <MajorUpgrade DowngradeErrorMessage="A newer TaskHandoff Remote Desktop installation is already present." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPHELPLINK" Value="https://github.com/edgestorage/task-handoff" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="TaskHandoffDirectory" Name="TaskHandoff">
          <Directory Id="INSTALLFOLDER" Name="RemoteDesktop" />
        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents">
      <Component
        Id="DesktopStreamingExecutable"
        Directory="INSTALLFOLDER"
        Guid="{97534F15-24F5-47E0-9838-7A9B7F790DAA}"
        Win64="yes">
        <RegistryValue
          Root="HKCU"
          Key="Software\TaskHandoff\RemoteDesktop"
          Name="DesktopStreamingExecutable"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <File
          Id="DesktopStreamingExe"
          Name="task-handoff-desktop-streaming.exe"
          Source="$(var.SourceDir)\task-handoff-desktop-streaming.exe"
          />
        <RemoveFolder Id="RemoveINSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveTaskHandoffDirectory" Directory="TaskHandoffDirectory" On="uninstall" />
      </Component>
      <Component
        Id="DesktopStreamingDocuments"
        Directory="INSTALLFOLDER"
        Guid="{36DB8A57-3756-482A-9FE0-29FC266FB35C}"
        Win64="yes">
        <RegistryValue
          Root="HKCU"
          Key="Software\TaskHandoff\RemoteDesktop"
          Name="DesktopStreamingDocuments"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <File Id="ComponentMetadata" Name="component.json" Source="$(var.SourceDir)\component.json" />
        <File Id="Readme" Name="README.md" Source="$(var.SourceDir)\README.md" />
        <File Id="License" Name="LICENSE" Source="$(var.SourceDir)\LICENSE" />
        <File Id="Notice" Name="NOTICE" Source="$(var.SourceDir)\NOTICE" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="TaskHandoff Remote Desktop" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>
</Wix>
