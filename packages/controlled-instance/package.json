{
  "name": "@task-handoff/controlled-instance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./web/*": {
      "types": "./src/web/*.ts",
      "default": "./src/web/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@task-handoff/app-runtime": "workspace:*",
    "@task-handoff/ai-session-runtime": "workspace:*",
    "@task-handoff/core": "workspace:*",
    "@task-handoff/protocol": "workspace:*",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@iarna/toml": "^2.2.5",
    "chokidar": "^5.0.0",
    "cron-parser": "^5.6.2",
    "fastify": "^5.6.2",
    "httpxy": "^0.5.3",
    "picomatch": "^4.0.5",
    "tar": "^7.5.20",
    "write-file-atomic": "^8.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
