{
  "name": "@task-handoff/node-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./bootstrap-assets": {
      "types": "./src/runtimes/bootstrap-assets.ts",
      "default": "./src/runtimes/bootstrap-assets.ts"
    },
    "./executor": {
      "types": "./src/runtimes/docker.ts",
      "default": "./src/runtimes/docker.ts"
    },
    "./folders": {
      "types": "./src/folders.ts",
      "default": "./src/folders.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build && node ../../bin/check-package-boundaries.js",
    "test": "node --import ../../test/setup-isolated-runtime.mjs --test --test-timeout=30000"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@task-handoff/cloud-contracts": "workspace:*",
    "@task-handoff/core": "workspace:*",
    "@task-handoff/protocol": "workspace:*",
    "@task-handoff/runtime-shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.6.2",
    "semver": "^7.8.5",
    "tar": "^7.5.20",
    "write-file-atomic": "^7.0.1",
    "ws": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "typescript": "^6.0.3"
  }
}
