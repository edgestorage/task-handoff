{
  "name": "@task-handoff/control-plane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./node-agent": {
      "types": "./src/node-agent.ts",
      "default": "./src/node-agent.ts"
    },
    "./node-agent-folders": {
      "types": "./src/node-agent/folders.ts",
      "default": "./src/node-agent/folders.ts"
    },
    "./node-agent-schemas": {
      "types": "./src/node-agent/schemas.ts",
      "default": "./src/node-agent/schemas.ts"
    },
    "./node-agent-tunnel": {
      "types": "./src/control-plane/nodes/tunnel.ts",
      "default": "./src/control-plane/nodes/tunnel.ts"
    },
    "./chat-gateway": {
      "types": "./src/chat-gateway.ts",
      "default": "./src/chat-gateway.ts"
    },
    "./ai-session-presentation": {
      "types": "./src/control-plane/sessions/ai-session-presentation.ts",
      "default": "./src/control-plane/sessions/ai-session-presentation.ts"
    },
    "./chat-bridge-records": {
      "types": "./src/control-plane/chat/bridges/records.ts",
      "default": "./src/control-plane/chat/bridges/records.ts"
    },
    "./config-sync": {
      "types": "./src/control-plane/instances/config-sync.ts",
      "default": "./src/control-plane/instances/config-sync.ts"
    },
    "./telegram-gateway": {
      "types": "./src/control-plane/chat/adapters/telegram-gateway.ts",
      "default": "./src/control-plane/chat/adapters/telegram-gateway.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./public-records": {
      "types": "./src/control-plane/public-records.ts",
      "default": "./src/control-plane/public-records.ts"
    },
    "./store": {
      "types": "./src/public/store.ts",
      "default": "./src/public/store.ts"
    },
    "./executor": {
      "types": "./src/node-agent/runtimes/docker.ts",
      "default": "./src/node-agent/runtimes/docker.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build && pnpm run check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@task-handoff/core": "workspace:*",
    "@task-handoff/protocol": "workspace:*",
    "@fastify/cookie": "^11.1.1",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "dingtalk-stream": "2.1.5",
    "fastify": "^5.6.2",
    "semver": "^7.8.5",
    "write-file-atomic": "^8.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "typescript": "^6.0.3"
  }
}
