{
  "name": "@task-handoff/runtime-shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@task-handoff/core": "workspace:*",
    "@task-handoff/cloud-contracts": "workspace:*",
    "@task-handoff/protocol": "workspace:*",
    "tweetnacl": "^1.0.3",
    "write-file-atomic": "^7.0.1",
    "ws": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
