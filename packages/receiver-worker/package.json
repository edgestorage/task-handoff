{
  "name": "@task-handoff/receiver-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agents/*": {
      "types": "./src/agents/*.ts",
      "default": "./src/agents/*.ts"
    },
    "./app": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./controllers/*": {
      "types": "./src/controllers/*.ts",
      "default": "./src/controllers/*.ts"
    },
    "./domain/*": {
      "types": "./src/domain/*.ts",
      "default": "./src/domain/*.ts"
    },
    "./initial-state": {
      "types": "./src/initial-state.ts",
      "default": "./src/initial-state.ts"
    },
    "./integrations/*": {
      "types": "./src/integrations/*.ts",
      "default": "./src/integrations/*.ts"
    },
    "./receiver-entry": {
      "types": "./src/receiver-entry.ts",
      "default": "./src/receiver-entry.ts"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "default": "./src/runtime/*.ts"
    },
    "./state/*": {
      "types": "./src/state/*.ts",
      "default": "./src/state/*.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./view/*": {
      "types": "./src/view/*.ts",
      "default": "./src/view/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@task-handoff/ai-session-runtime": "workspace:*",
    "@task-handoff/core": "workspace:*",
    "@task-handoff/protocol": "workspace:*",
    "@task-handoff/terminal-ui": "workspace:*",
    "async-retry": "^1.3.3",
    "axios": "^1.16.1",
    "dingtalk-stream": "2.1.5",
    "ink": "^7.0.3",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.6",
    "react-ink-textarea": "^0.1.3",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  }
}
