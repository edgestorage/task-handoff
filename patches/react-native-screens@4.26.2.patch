diff --git a/ios/RNSScreen.mm b/ios/RNSScreen.mm
index 9b66012dc8db1e3af0cb5457f8dad86e7f2fe5e3..23cf2256c77f7abfb7d442adba8f75de71f879d9 100644
--- a/ios/RNSScreen.mm
+++ b/ios/RNSScreen.mm
@@ -599,6 +599,11 @@ - (void)didMoveToWindow
   } else {
     [_touchHandler detachFromView:self];
   }
+
+  // An ancestor screen attached to its container re-applies its own effects to this scroll view first.
+  if (self.window != nil && ![RNSScrollEdgeEffectApplicator hasOnlyAutomaticEffects:self]) {
+    [self updateContentScrollViewEdgeEffectsIfExists];
+  }
 }
 
 - (nullable RCTSurfaceTouchHandler *)touchHandler
@@ -1417,6 +1422,39 @@
   BOOL _isSwiping;
   BOOL _shouldNotify;
   BOOL _isRemovedFromParent;
+}
+
+#if !TARGET_OS_TV
+- (nullable UIScrollView *)firstDescendantScrollViewInView:(UIView *)view
+{
+  if ([view isKindOfClass:UIScrollView.class]) {
+    return static_cast<UIScrollView *>(view);
+  }
+
+  for (UIView *subview in view.subviews) {
+    UIScrollView *scrollView = [self firstDescendantScrollViewInView:subview];
+    if (scrollView != nil) {
+      return scrollView;
+    }
+  }
+
+  return nil;
+}
+
+- (nullable UIScrollView *)contentScrollViewForEdge:(NSDirectionalRectEdge)edge
+{
+  if (edge == NSDirectionalRectEdgeTop) {
+    // A master-detail pane can place an empty composited view before the list scroll view, which defeats
+    // UIKit's first-subview heuristic. Resolve the first real descendant so large titles and scroll-edge
+    // effects track the list pane across compact and split layouts.
+    UIScrollView *scrollView = [self firstDescendantScrollViewInView:self.view];
+    if (scrollView != nil) {
+      return scrollView;
+    }
+  }
+
+  return [super contentScrollViewForEdge:edge];
 }
+#endif // !TARGET_OS_TV
-
