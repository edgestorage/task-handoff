+  ///
+  /// @brief Keeps the column wrapper aligned with the split host's safe area.
+  ///
+  /// UISplitViewController can add the enclosing top safe area a second time while
+  /// a column is resized. The wrapper has no navigation chrome of its own, so its
+  /// top inset must match its parent. Compensate without touching horizontal or
+  /// bottom insets, which can carry device safe area into the column.
+  ///
+  override public func viewSafeAreaInsetsDidChange() {
+    super.viewSafeAreaInsetsDidChange()
+    correctSafeAreaIfNeeded()
+  }
+
+  private func correctSafeAreaIfNeeded() {
+    guard !isApplyingSafeAreaCorrection, let parentView = parent?.view else { return }
+
+    let currentInsets = view.safeAreaInsets
+    let appliedInsets = additionalSafeAreaInsets
+    let systemInsets = UIEdgeInsets(
+      top: currentInsets.top - appliedInsets.top,
+      left: currentInsets.left - appliedInsets.left,
+      bottom: currentInsets.bottom - appliedInsets.bottom,
+      right: currentInsets.right - appliedInsets.right
+    )
+    let correctedTop = parentView.safeAreaInsets.top - systemInsets.top
+    guard abs(correctedTop - appliedInsets.top) >= 0.5 else { return }
+
+    var correction = appliedInsets
+    correction.top = correctedTop
+
+    isApplyingSafeAreaCorrection = true
+    additionalSafeAreaInsets = correction
+    isApplyingSafeAreaCorrection = false
+  }
+
   private func onViewOriginChange() {
     viewFrameOriginChangeObserver?.splitNavCtrlViewDidChangeFrameOrigin(self)
   }
